<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for DIRECT (Developer ID) distribution — NOT the
  Mac App Store. Plume is intentionally not sandboxed: it spawns the plume-mcp
  Node process, binds a Unix socket at ~/.plume/plume.sock, and reads
  ~/.claude / ~/.codex / ~/.gemini to browse agent sessions. The App Sandbox
  (required by MAS) forbids all of that — see packaging/SHIP.md.

  WKWebView needs JIT; everything else is the default hardened runtime.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!--
    com.apple.security.cs.allow-dyld-environment-variables is intentionally NOT set.
    Spawning the Node sidecar does not require loosening this process's dyld env, and
    that entitlement would let a local attacker inject code via DYLD_INSERT_LIBRARIES.
    WKWebView needs only allow-jit.
  -->
</dict>
</plist>
