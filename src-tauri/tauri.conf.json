{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.0",
  "identifier": "ai.plume.desktop",
  "build": {
    "frontendDist": "../build-tauri"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["plume"]
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Plume",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "**/.ssh/**", "**/.aws/**", "**/.gnupg/**", "**/.kube/**",
            "**/.docker/**", "**/.config/**", "**/.password-store/**",
            "**/.env", "**/.env.*", "**/.netrc", "**/.git-credentials",
            "**/.npmrc", "**/.pypirc", "**/secrets/**",
            "**/Library/Keychains/**", "**/*.keychain*",
            "**/*.pem", "**/*.key", "**/*.p12", "**/*.pfx", "**/*.ovpn",
            "**/id_rsa*", "**/id_ed25519*", "**/id_ecdsa*", "**/id_dsa*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../packaging/macos/entitlements.plist"
    },
    "resources": ["sidecar/plume-sidecar.cjs"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx", "txt", "text"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  }
}
