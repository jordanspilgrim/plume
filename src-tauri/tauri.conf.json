{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.0",
  "identifier": "com.gabriel.plume",
  "build": {
    "frontendDist": "../build-tauri"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["plume"]
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Plume",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "**/.ssh/**", "**/.aws/**", "**/.gnupg/**", "**/.kube/**",
            "**/.docker/**", "**/.config/gh/**", "**/.config/gcloud/**",
            "**/.env", "**/.env.*", "**/.netrc", "**/.git-credentials",
            "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../packaging/macos/entitlements.plist"
    },
    "resources": ["sidecar/plume-sidecar.cjs"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx", "txt", "text"],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["json", "jsonc", "jsonl", "ndjson", "yaml", "yml", "toml", "ini", "env", "conf", "cfg", "diff", "patch", "log", "csv", "tsv", "mmd", "xml", "svg", "js", "jsx", "mjs", "cjs", "ts", "tsx", "py", "rs", "go", "sh", "bash", "zsh", "sql", "css", "html"],
        "name": "Source & Data File",
        "role": "Editor"
      }
    ]
  }
}
