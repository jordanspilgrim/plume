{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.0",
  "identifier": "com.gabriel.plume",
  "build": {
    "frontendDist": "../build-tauri"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Plume",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx", "txt", "text"],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["json", "jsonl", "ndjson", "yaml", "yml", "toml", "diff", "patch", "log", "csv", "tsv", "mmd"],
        "name": "Source & Data File",
        "role": "Editor"
      }
    ]
  }
}
